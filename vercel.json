{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agents",
      "destination": "/index.html"
    },
    {
      "source": "/agents/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/wasm",
      "destination": "/index.html"
    },
    {
      "source": "/wasm/(.*)",
      "destination": "/index.html"
    }
  ]
}
